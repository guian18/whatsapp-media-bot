{
  "name": "whatsapp-bot-infoplayerleft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot de WhatsApp que consulta jugadores y servidores de Left 4 Dead 2 (Steam Web API + A2S)",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "start:termux": "termux-wake-lock 2>/dev/null; node bot.js",
    "reset": "node scripts/reset.js",
    "relink": "node scripts/reset.js && node bot.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
