{
  "name": "whatsapp-bot-infoplayerleft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot de WhatsApp que consulta jugadores y servidores de Left 4 Dead 2 (Steam Web API + A2S)",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "start:termux": "termux-wake-lock 2>/dev/null; node bot.js",
    "reset": "node scripts/reset.js",
    "relink": "node scripts/reset.js && node bot.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "git+https://github.com/WhiskeySockets/Baileys.git#834dc742e349958fd162f7a2239514e9b237fb5a",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
