FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HERMES_HOME=/data/.hermes \
    API_SERVER_ENABLED=true \
    API_SERVER_HOST=0.0.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl build-essential ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e /opt/hermes-agent

RUN mkdir -p /data/.hermes && chmod 700 /data/.hermes

WORKDIR /data

# Railway supplies PORT. Hermes defaults to 8642 when PORT is absent locally.
CMD ["sh", "-c", "export API_SERVER_PORT=\"${PORT:-8642}\"; exec hermes gateway"]
