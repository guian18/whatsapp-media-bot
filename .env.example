# Clave de la Steam Web API: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Opcional: vincular con número de celular (código de 8 dígitos en vez de QR).
# Solo dígitos, con código de país. Ejemplo Perú: 51987654321
WHATSAPP_NUMBER=

# Opcional: pon true para que el bot pregunte el número por consola al arrancar
PAIRING_CODE=false

# Opcional: limita el bot a ciertos grupos (IDs separados por coma, terminan en @g.us)
ALLOWED_GROUPS=

# Opcional: pon false para que el bot ignore los chats privados
REPLY_IN_PRIVATE=false

# Opcional: carpeta donde se guarda la sesión de WhatsApp (por defecto auth_info)
AUTH_DIR=

# Opcional pero recomendado en Railway: protege /qr, /status y /pair
PAIRING_ADMIN_TOKEN=

# Opcional: permite probar comandos enviados desde la cuenta vinculada
ALLOW_SELF=false

# Opcional: pon false para no reiniciar automáticamente si WhatsApp invalida la sesión
AUTO_RESET=false

# Opcional para consultar servidores de una red local; déjalo false en hosting público
ALLOW_PRIVATE_SERVERS=false
